# PostgreSQL used by docker-compose.yml
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=crm_db
POSTGRES_PORT=5434

# Application
APP_PORT=5100
APP_BIND_ADDRESS=0.0.0.0
COOKIE_SIGN_SECRET=replace-with-at-least-32-random-characters

# Enable only after HTTPS is configured at the reverse proxy/domain.
ENABLE_HSTS=false

# Optional Zalo OA integration
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_TEMPLATE_THANK_YOU=
ZALO_TEMPLATE_OIL_REMIND=
ZALO_TEMPLATE_BIRTHDAY=
ZALO_TEMPLATE_INSPECT=
